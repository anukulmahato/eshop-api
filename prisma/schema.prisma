generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Brand {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String @unique
  slug String @unique
  logo String?



  status Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Category {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String @unique
  slug String @unique
  photo String?



  status Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Tag {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String @unique
  slug String @unique



  status Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
